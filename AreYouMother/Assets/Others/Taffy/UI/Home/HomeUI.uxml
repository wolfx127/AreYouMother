<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="root" style="flex-grow: 1;">
        <ui:VisualElement name="TopPivot" style="flex-grow: 0; flex-direction: row; transform-origin: center; min-height: 8%; max-height: none; flex-shrink: 0;">
            <ui:VisualElement name="_LeftPivot" style="flex-grow: 0; flex-direction: row; flex-shrink: 0; width: 30%;">
                <ui:Button text="进入对局" name="EngagePlayBtn" style="flex-grow: 0; flex-shrink: 0; width: 30%;" />
                <ui:Button text="商人" name="DealerBtn" style="flex-shrink: 0; flex-grow: 0; width: 20%;" />
            </ui:VisualElement>
            <ui:VisualElement name="_CenterPivot" style="flex-grow: 0; flex-shrink: 0; width: 40%;" />
            <ui:VisualElement name="_RightPivot" style="flex-grow: 0; flex-direction: row-reverse; flex-shrink: 0; width: 30%;">
                <ui:Button text="退出游戏" name="ExitGameBtn" style="flex-grow: 0; width: 30%;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="CenterPivot" style="flex-grow: 0; flex-direction: row; max-height: none; min-height: auto; flex-shrink: 0; height: 80%;">
            <ui:VisualElement name="_LeftPivot" style="flex-grow: 0; background-color: rgb(125, 85, 31); flex-shrink: 0; width: 30%;" />
            <ui:VisualElement name="_CenterPivot" style="flex-grow: 0; background-color: rgb(93, 61, 34); flex-shrink: 0; width: 40%;">
                <ui:VisualElement name="__TopPivot" style="flex-grow: 0; height: 5%; flex-shrink: 0;" />
                <ui:VisualElement name="__CenterPivot" style="flex-grow: 0; flex-shrink: 0; width: auto; height: 80%;">
                    <ui:ScrollView name="CenterScroll" mode="Vertical" style="flex-grow: 1; flex-shrink: 0; width: 100%; height: 100%; border-left-color: rgb(196, 196, 196); border-right-color: rgb(196, 196, 196); border-top-color: rgb(196, 196, 196); border-bottom-color: rgb(196, 196, 196); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-right-radius: 2px; border-bottom-left-radius: 2px;">
                        <ui:VisualElement name="CenterCatalogue" style="flex-direction: row; flex-wrap: wrap; align-items: flex-start; width: 100%;" />
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement name="__BottomPivot" style="flex-grow: 0; flex-shrink: 0; height: 15%;" />
            </ui:VisualElement>
            <ui:VisualElement name="_RightPivot" style="flex-grow: 0; background-color: rgb(125, 85, 31); flex-shrink: 0; width: 30%; flex-direction: column;" />
        </ui:VisualElement>
        <ui:VisualElement name="BottomPivot" style="flex-grow: 0; min-height: auto; max-height: none; flex-shrink: 0; height: 12%;" />
    </ui:VisualElement>
</ui:UXML>
