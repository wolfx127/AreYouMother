<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="root" style="flex-grow: 1;">
        <ui:VisualElement name="TopPivot" style="flex-grow: 1; flex-direction: row; transform-origin: center; min-height: 8%; max-height: 10%;">
            <ui:VisualElement name="_LeftPivot" style="flex-grow: 1; flex-direction: row;">
                <ui:Button text="进入对局" name="EngagePlayBtn" style="flex-grow: 0; flex-shrink: 0;" />
                <ui:Button text="商人" name="DealerBtn" style="flex-shrink: 0; flex-grow: 0;" />
            </ui:VisualElement>
            <ui:VisualElement name="_CenterPivot" style="flex-grow: 1;" />
            <ui:VisualElement name="_RightPivot" style="flex-grow: 1; flex-direction: row-reverse;">
                <ui:Button text="退出游戏" name="ExitGameBtn" style="flex-grow: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="CenterPivot" style="flex-grow: 1; flex-direction: row; max-height: 80%; min-height: 75px;">
            <ui:VisualElement name="_LeftPivot" style="flex-grow: 1; background-color: rgb(125, 85, 31);">
                <ui:VisualElement name="BasicProps_A" style="flex-grow: 1; flex-shrink: 0;" />
            </ui:VisualElement>
            <ui:VisualElement name="_CenterPivot" style="flex-grow: 1; background-color: rgb(93, 61, 34);">
                <ui:ScrollView style="flex-grow: 0;" />
            </ui:VisualElement>
            <ui:VisualElement name="_RightPivot" style="flex-grow: 1; background-color: rgb(125, 85, 31);">
                <ui:VisualElement name="BasiscProps_B" style="flex-grow: 1; flex-shrink: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BottomPivot" style="flex-grow: 1; min-height: 5%; max-height: 10%;" />
    </ui:VisualElement>
</ui:UXML>
